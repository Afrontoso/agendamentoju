generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
}
